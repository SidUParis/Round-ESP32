+// Round ESP32: nonblocking UI snapshot; no transport credentials are exposed.
+bool XiaozhiApp::round_snapshot(RoundSnapshot &out)
+{
+    out.state = static_cast<int>(_state.load());
+    strlcpy(out.status, stateText(_state.load()), sizeof(out.status));
+    if (!_state_mutex || xSemaphoreTake(_state_mutex, 0) != pdTRUE) return false;
+    strlcpy(out.text, _chat_text, sizeof(out.text));
+    if (_state.load() == State::ActivationRequired)
+        strlcpy(out.activation, _activation_code, sizeof(out.activation));
+    xSemaphoreGive(_state_mutex);
+    return true;
+}
+const lv_font_t *XiaozhiApp::round_font() const { return _ui ? _ui->round_font() : nullptr; }
+
